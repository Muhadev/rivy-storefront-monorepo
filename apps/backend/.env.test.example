# Test Environment Configuration
# Copy this file to .env.test for running tests

# Test Database Configuration
DATABASE_URL=postgres://rivy:rivy@localhost:5432/rivy_test

# Test Server Configuration  
PORT=4001
NODE_ENV=test

# Authentication (can use same as development for tests)
JWT_SECRET=test_jwt_secret_key

# Rate Limiting (more permissive for tests)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000

# CORS Configuration
CORS_ORIGIN=*

# Business Configuration
TAX_RATE=0.05
