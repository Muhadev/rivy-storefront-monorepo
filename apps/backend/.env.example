# Rivy Storefront Backend Environment Configuration
# Copy this file to .env and update the values as needed

# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
# For local development with Docker: postgres://rivy:rivy@db:5432/rivy
# For local development without Docker: postgres://rivy:rivy@localhost:5432/rivy
DATABASE_URL=postgres://rivy:rivy@db:5432/rivy

# Authentication
# Generate a secure random string for production
JWT_SECRET=changeme_supersecret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# CORS Configuration
# Use specific origins in production (e.g., https://yourdomain.com)
CORS_ORIGIN=*

# Business Configuration
TAX_RATE=0.05

# Test Database Configuration (for running tests)
# This should point to a separate test database
# Example: postgres://rivy:rivy@localhost:5432/rivy_test
TEST_DATABASE_URL=postgres://rivy:rivy@localhost:5432/rivy_test
