    {
      "name": "Checkout & Orders",
      "item": [
        {
          "name": "Simulate Checkout",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Add item to cart before checkout",
                  "pm.sendRequest({",
                  "    url: pm.globals.get('baseUrl') + '/api/v1/cart/items',",
                  "    method: 'POST',",
                  "    header: {",
                  "        'Content-Type': 'application/json',",
                  "        'Authorization': 'Bearer ' + pm.globals.get('authToken')",
                  "    },",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({",
                  "            productId: parseInt(pm.globals.get('productId')),",
                  "            quantity: 1",
                  "        })",
                  "    }",
                  "}, function(err, res) {",
                  "    console.log('Pre-checkout cart setup completed');",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Checkout successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Order created', function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.order).to.have.property('id');",
                  "    pm.expect(responseJson.order).to.have.property('total');",
                  "    pm.globals.set('orderId', responseJson.order.id);",
                  "});"
