PORT=4001
NODE_ENV=test
DATABASE_URL=postgres://rivy:rivy@localhost:5432/rivy_test
JWT_SECRET=test_jwt_secret_key_for_testing
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
CORS_ORIGIN=*
TAX_RATE=0.05

# DB variables for docker-compose
POSTGRES_DB=rivy
POSTGRES_USER=rivy
POSTGRES_PASSWORD=rivy
POSTGRES_PORT=5432
POSTGRES_IMAGE=postgres:15

# Backend variables for docker-compose
BACKEND_PORT=4000
BACKEND_NODE_ENV=development
BACKEND_DATABASE_URL=postgres://rivy:rivy@db:5432/rivy
