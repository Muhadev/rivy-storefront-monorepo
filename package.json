{
  "name": "rivy-storefront",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm --workspace apps/backend run dev",
    "dev:frontend": "npm --workspace apps/frontend run dev",
    "build": "npm -w apps/backend run build && npm -w apps/frontend run build",
    "build:backend": "npm -w apps/backend run build",
    "test": "npm -w apps/backend test && npm -w apps/frontend test"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "dependencies": {
    "@types/express-winston": "^3.0.4",
    "@types/winston": "^2.4.4",
    "express-winston": "^4.2.0",
    "winston": "^3.17.0"
  }
}
